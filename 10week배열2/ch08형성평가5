#include <stdio.h>

int main(void)
{
    int scores[4][4] = {0};
    int total = 0;

    for (int i = 0; i < 4; i++)
    {
        for (int j = 0; j < 3; j++)
        {
            scanf("%d", &scores[i][j]);
            scores[i][3] += scores[i][j];
        }
        total += scores[i][3];
    }

    for (int i = 0; i < 4; i++)
    {
        printf("%d\n", scores[i][3]);
    }
    printf("%d\n", total);

    return 0;
}