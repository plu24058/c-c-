#include <stdio.h>

int main(void) {
    int arr[100];
    int count = 0;
    
    while (1) {
        scanf("%d", &arr[count]);
        if (arr[count] == 0) {
            break;
        }
        count++;
    }
    
    printf("%d\n", count);
    
    for (int i = 0; i < count; i++) {
        if (arr[i] % 2 != 0) {
            printf("%d ", arr[i] * 2);
        } else {
            printf("%d ", arr[i] / 2);
        }
    }
    printf("\n");
    
    return 0;
}