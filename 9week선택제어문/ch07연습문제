#include <stdio.h>

int main() {
    int choice;
    
    printf("1. ADD\n");
    printf("2. EDIT\n");
    printf("3. DEL\n");
    printf("Select: ");
    scanf("%d", &choice);
    
    switch(choice) {
        case 1:
            printf("added\n");
            break;
        case 2:
            printf("edited\n");
            break;
        case 3:
            printf("deleted\n");
            break;
        default:
            printf("none\n");
            break;
    }
    
    return 0;
}