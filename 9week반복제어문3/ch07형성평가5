#include <stdio.h>

int main(void) {
    int n;
    scanf("%d", &n);

    char ch = 'A';
    int num = 0;

    for (int i = 1; i <= n; i++) {
        for (int j = 0; j <= n - i; j++) {
            printf("%c ", ch++);
        }
        for (int j = 0; j < i - 1; j++) {
            printf("%d ", num++);
        }
        printf("\n");
    }

    return 0;
}