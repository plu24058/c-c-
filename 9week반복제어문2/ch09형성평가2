#include <stdio.h>

int main(void)
{
    int a, b;
    scanf("%d %d", &a, &b);

    if (a >= 1 && a <= 100 && b >= 1 && b <= 100)
    {
        if (a > b)
        {
            int temp = a;
            a = b;
            b = temp;
        }

        for (int i = a; i <= b; i++)
        {
            printf("%d ", i);
        }
        printf("\n");
    }

    return 0;
}