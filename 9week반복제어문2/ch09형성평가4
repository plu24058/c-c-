#include <stdio.h>

int main(void) {
    int n, score, sum = 0;
    scanf("%d", &n);

    if (n >= 1 && n <= 100) {
        for (int i = 0; i < n; i++) {
            scanf("%d", &score);
            sum += score;
        }

        double avg = (double)sum / n;
        printf("%.2f\n", avg);
    }

    return 0;
}