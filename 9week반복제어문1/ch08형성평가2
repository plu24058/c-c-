#include <stdio.h>

int main(void) {
    int num;
    int odd_count = 0;
    int even_count = 0;

    while (1) {
        scanf("%d", &num);

        if (num == 0) {
            break;
        }

        if (num % 2 == 0) {
            even_count++;
        } else {
            odd_count++;
        }
    }

    printf("odd : %d\n", odd_count);
    printf("even : %d\n", even_count);

    return 0;
}