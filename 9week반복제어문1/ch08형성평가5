#include <stdio.h>

int main(void) {
    double base, height, area;
    char choice;

    do {
        printf("Base = ");
        scanf("%lf", &base);
        
        printf("Height = ");
        scanf("%lf", &height);

        area = (base * height) / 2.0;

        printf("Triangle Width = %.1f\n", area);

        printf("Continue? ");
        scanf(" %c", &choice);

    } while (choice == 'Y' || choice == 'y');

    return 0;
}