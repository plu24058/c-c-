#include <stdio.h>

int main(void) {
    int num;
    int count = 0;
    int sum = 0;
    
    while (1) {
        scanf("%d", &num);
        
        if (num == 0) {
            break;
        }
        
        sum += num;
        count++;
    }
    
    if (count > 0) {
        double avg = (double)sum / count;
        printf("자료의 수 : %d\n", count);
        printf("합계 : %d\n", sum);
        printf("평균 : %.2f\n", avg);
    }
    
    return 0;
}